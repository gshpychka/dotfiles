diff --git a/drivers/amlogic/media/enhancement/amdolby_vision/amdolby_vision.c b/drivers/amlogic/media/enhancement/amdolby_vision/amdolby_vision.c
--- a/drivers/amlogic/media/enhancement/amdolby_vision/amdolby_vision.c
+++ b/drivers/amlogic/media/enhancement/amdolby_vision/amdolby_vision.c
@@ -274,6 +274,22 @@
 module_param(dolby_vision_dolby_vsvdb_brightness_lvl_pq20, int, 0664);
 MODULE_PARM_DESC(dolby_vision_dolby_vsvdb_brightness_lvl_pq20, "\n dolby_vision_dolby_vsvdb_brightness_lvl_pq20\n");
 
+// Whether VPP brightness2 holds the brightness adjustment above.
+static bool dv_ll_brightness_applied;
+
+// brightness2 adjusts all VPP output, so the adjustment holds only while DV-LL
+// runs with min PQ 20.
+static void set_dv_ll_brightness(bool apply)
+{
+	if (apply) {
+		amvecm_set_brightness2(dolby_vision_dolby_vsvdb_brightness_lvl_pq20);
+		dv_ll_brightness_applied = true;
+	} else if (dv_ll_brightness_applied) {
+		amvecm_set_brightness2(0);
+		dv_ll_brightness_applied = false;
+	}
+}
+
 static bool dolby_vision_hdr_for_dv_ll = false;
 module_param(dolby_vision_hdr_for_dv_ll, bool, 0664);
 MODULE_PARM_DESC(dolby_vision_hdr_for_dv_ll, "\n dolby_vision_hdr_for_dv_ll\n");
@@ -1959,6 +1975,7 @@
 			VSYNC_WR_DV_REG(VIU_MISC_CTRL1, viu_misc_ctrl_backup | (3 << 16));
 			VSYNC_WR_DV_REG(VPP_MATRIX_CTRL, vpp_matrix_backup);
 			VSYNC_WR_DV_REG(VPP_DUMMY_DATA1, vpp_dummy1_backup);
+			set_dv_ll_brightness(false);
 		}
 
 		frame_count = 0;
@@ -4960,10 +4977,8 @@
 		limit_dolby_vsvdb_to_source_lum_for_dv_ll();
 
 		// When min source set to PQ 20, apply brightness correction.
