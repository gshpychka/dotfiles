-		if (dolby_vision_dolby_vsvdb_source_lum_limit == (2+3))
-			amvecm_set_brightness2(dolby_vision_dolby_vsvdb_brightness_lvl_pq20);
+		set_dv_ll_brightness(dolby_vision_dolby_vsvdb_source_lum_limit == (2+3));
 	}
 
