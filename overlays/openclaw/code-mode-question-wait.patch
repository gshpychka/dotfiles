From 38663ae07a6797d4e17212cd8955e4447a65fd4e Mon Sep 17 00:00:00 2001
From: Glib Shpychka <23005347+gshpychka@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:06:09 +0300
Subject: [PATCH] fix(code-mode): hold exec while a question waits for its
 answer

An ask_user or secrets request called from exec now requires completion,
so exec returns the answer instead of a waiting handle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LNTt5yXBj4uDUwJmPGvXLd
---
 src/agents/code-mode-bridge.ts    | 24 +++++++++++--------
 src/agents/code-mode.wait.test.ts | 39 +++++++++++++++++++++++++++++++
 2 files changed, 53 insertions(+), 10 deletions(-)

diff --git a/src/agents/code-mode-bridge.ts b/src/agents/code-mode-bridge.ts
index 3aa392e817c..f3534fa64c9 100644
--- a/src/agents/code-mode-bridge.ts
+++ b/src/agents/code-mode-bridge.ts
@@ -210,24 +210,28 @@ function requireCodeModeSwarmEnabled(ctx: ToolSearchToolContext): void {
   }
 }
 
-/** Recognize explicit required intent only on the authorized core tool bindings. */
+/** Recognize core tool calls the exec holds until they settle: explicit required waits and questions. */
 export function requiresCodeModeCompletion(
   requests: readonly PendingBridgeRequest[],
   catalogProjection: CodeModeCatalogProjection,
 ): boolean {
   return requests.some((request) => {
+    if (request.method !== "callValue" || typeof request.args[0] !== "string") {
+      return false;
+    }
+    const id = catalogProjection.byCallableName.get(request.args[0])?.id;
+    const input = isRecord(request.args[1]) ? request.args[1] : {};
+    // A parked cell closes with its turn, which cancels a question still waiting on its answer.
     if (
-      request.method !== "callValue" ||
-      !isRecord(request.args[1]) ||
-      request.args[1].awaitResults !== true
+      id === "openclaw:core:ask_user" ||
+      (id === "openclaw:core:secrets" && input.action === "request")
     ) {
-      return false;
+      return true;
     }
-    const binding =
-      typeof request.args[0] === "string"
-        ? catalogProjection.byCallableName.get(request.args[0])
-        : undefined;
-    return binding?.id === "openclaw:core:exec" || binding?.id === "openclaw:core:agents_wait";
+    return (
+      input.awaitResults === true &&
+      (id === "openclaw:core:exec" || id === "openclaw:core:agents_wait")
+    );
   });
 }
 
