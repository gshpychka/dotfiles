 import { expectDefined } from "@openclaw/normalization-core";
 import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
 import { runWithAgentToolExecutionContext } from "../../packages/agent-core/src/tool-execution-context.js";
@@ -13,6 +14,7 @@ import * as codeModeState from "./code-mode-state.js";
 import { applyCodeModeCatalog, createCodeModeTools } from "./code-mode.js";
 import {
   createCodeModeHarness,
+  fakeTool,
   pluginTool,
   pluginToolWithExecute,
   resetCodeModeTestState,
@@ -191,6 +193,43 @@ describe("Code Mode wait, scope, and suspended runs", () => {
     }
   });
 
+  const waits: [name: string, input: Record<string, unknown>, holds: boolean][] = [
+    ["ask_user", {}, true],
+    ["secrets", { action: "request" }, true],
+    ["secrets", { action: "list" }, false],
+  ];
+  it.each(waits)("holds the exec for %s %j while it waits: %s", async (name, input, holds) => {
+    const answered = createDeferred();
+    const question = fakeTool(name, "Waits on a person");
+    question.execute = vi.fn(async () => {
+      await answered.promise;
+      return jsonResult({ answer: "keep" });
+    });
+    const fixture = harness([question], { codeMode: { timeoutMs: 200 } });
+    const execution = fixture.exec.execute("question-wait", {
+      code: `return await ${name}(${JSON.stringify(input)});`,
+    });
+    try {
+      if (holds) {
+        // Five exec budgets: an exec that does not hold has returned `waiting` by then.
+        const early = await Promise.race([execution, sleep(1_000).then(() => "held")]);
+        expect(early).toBe("held");
+        answered.resolve();
+        expect(resultDetails(await execution)).toMatchObject({
+          status: "completed",
+          value: { answer: "keep" },
+        });
+        expect(testing.activeRuns.size).toBe(0);
+      } else {
+        expect(resultDetails(await execution)).toMatchObject({ status: "waiting" });
+        expect(testing.activeRuns.size).toBe(1);
+      }
+    } finally {
+      answered.resolve();
+      await execution;
+    }
+  });
+
   it("refuses an unfinished explicit yield for required work", async () => {
     const fixture = harness([]);
     expect(
