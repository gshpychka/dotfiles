+let context: GatewayRequestContext;
+let currentContext: GatewayRequestContext | undefined;
+type Caller = NonNullable<Parameters<typeof withGatewayToolCallerIdentity>[0]>;
+async function withCaller<T>(overrides: Partial<Caller>, run: () => Promise<T>) {
+  const caller = {
+    agentId: "ops",
+    sessionKey: "agent:ops:main",
+    ...overrides,
+    operationalRunInstance:
+      overrides.operationalRunInstance ?? createOperationalRunInstanceRef("requester-regression"),
+  };
+  const authority = claimAgentRunDelegatedAuthority(caller.operationalRunInstance);
+  try {
+    return await withGatewayToolCallerIdentity(
+      { ...caller, receiptAuthority: () => validateAgentRunDelegatedAuthority(authority) },
+      run,
+    );
+  } finally {
+    releaseAgentRunDelegatedAuthority(authority);
+  }
+}
+
+// No mocked server-methods or scope admission: tools, router, handlers and store are real.
+describe("scoped System approval requester through Gateway router", () => {
+  beforeEach(() => {
+    setRuntimeConfigSnapshot({ gateway: { mode: "local", port: 18789 } });
