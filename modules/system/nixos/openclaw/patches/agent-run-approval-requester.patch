+              controller.abort(new Error("requesting tool cancelled"));
+              expect(await manager.resolve(cancelled.id, "allow-once")).toBe(false);
+              expect(manager.projectDecisionIfActive(cancelled.id, "allow-once")).toBeNull();
+              const admittedContext = currentContext;
