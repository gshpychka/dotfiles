+import { agentRuntimeConnId } from "./agent-runtime-identity-token.js";
+import type { GatewayRequestContext, GatewayRequestOptions } from "./server-methods/types.js";
+
+/** Whether a live agent run's own client may register an exec approval and await its decision. */
+export function holdsAgentRuntimeApprovalRequesterAuthority(
+  method: string,
+  client: GatewayRequestOptions["client"],
+  context: Pick<GatewayRequestContext, "validateAgentRuntimeApprovalAuthority">,
+): boolean {
+  if (method !== "exec.approval.request" && method !== "exec.approval.waitDecision") {
+    return false;
+  }
+  const identity = client?.internal?.agentRuntimeIdentity;
+  return Boolean(
+    client?.internal?.syntheticClient === true &&
+    !client.invalidated &&
+    identity &&
+    client.connId === agentRuntimeConnId(identity) &&
+    context.validateAgentRuntimeApprovalAuthority?.(identity) === true,
+  );
+}
