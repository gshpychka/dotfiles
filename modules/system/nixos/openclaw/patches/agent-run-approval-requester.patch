+import { describe, expect, it, vi } from "vitest";
+import { holdsAgentRuntimeApprovalRequesterAuthority } from "./agent-runtime-approval-requester.js";
+import type { AgentRuntimeIdentity } from "./agent-runtime-identity-token.js";
+import { createSyntheticPluginRuntimeClient } from "./server-plugin-runtime-client.js";
+
+function fixture() {
+  const operationalRunInstance = { instanceId: "requester-instance", runId: "requester-run" };
+  const identity: AgentRuntimeIdentity = {
+    kind: "agentRuntime",
+    agentId: "main",
+    sessionKey: "agent:main:main",
+    operationalRunInstance,
+    delegatedAuthority: {
+      kind: "local",
+      operationalRunInstance,
+      lifecycleGeneration: "requester-generation",
+      claimId: "requester-claim",
+    },
+  };
+  const client = createSyntheticPluginRuntimeClient({
+    scopes: ["operator.write"],
+    operatorRoleActor: { kind: "system" },
+  });
+  client.connId = "agent-runtime:requester-instance";
+  client.internal = { ...client.internal, agentRuntimeIdentity: identity };
+  const validate = vi.fn((candidate: AgentRuntimeIdentity) => candidate === identity);
+  return {
+    identity,
+    client,
+    validate,
+    context: { validateAgentRuntimeApprovalAuthority: validate },
+  };
+}
+
+describe("agent runtime approval requester authority", () => {
+  it.each(["exec.approval.request", "exec.approval.waitDecision"])(
+    "admits %s without granting reviewer scopes",
+    (method) => {
+      const { client, identity, validate, context } = fixture();
+      expect(holdsAgentRuntimeApprovalRequesterAuthority(method, client, context)).toBe(true);
+      expect(validate).toHaveBeenCalledWith(identity);
+      expect(client.connect.scopes).toEqual(["operator.write"]);
+      expect(client.internal?.approvalRuntime).not.toBe(true);
+    },
+  );
+  it.each([
+    "exec.approval.resolve",
+    "exec.approval.get",
+    "exec.approval.list",
+    "plugin.approval.request",
+    "plugin.approval.waitDecision",
+    "config.patch",
+    "node.invoke",
+  ])("does not confer authority for %s", (method) => {
+    const { client, validate, context } = fixture();
+    expect(holdsAgentRuntimeApprovalRequesterAuthority(method, client, context)).toBe(false);
+    expect(validate).not.toHaveBeenCalled();
+  });
+  it.each([
+    "invalidated",
+    "foreign-connection",
+    "unsigned",
+    "non-synthetic",
+    "revoked",
+    "missing-validator",
+  ])("refuses %s authority", (reason) => {
+    const { client, validate, context } = fixture();
+    if (reason === "invalidated") {
+      client.invalidated = true;
+    }
+    if (reason === "foreign-connection") {
+      client.connId = "agent-runtime:foreign-instance";
+    }
+    if (reason === "unsigned") {
+      delete client.internal?.agentRuntimeIdentity;
+    }
+    if (reason === "non-synthetic") {
+      delete client.internal?.syntheticClient;
+    }
+    if (reason === "revoked") {
+      validate.mockReturnValue(false);
+    }
+    const currentContext = reason === "missing-validator" ? {} : context;
+    expect(
+      holdsAgentRuntimeApprovalRequesterAuthority("exec.approval.request", client, currentContext),
+    ).toBe(false);
+  });
+});
