From 394834c65731cc4831be7b62b3e8afed160a45ca Mon Sep 17 00:00:00 2001
From: Glib Shpychka <23005347+gshpychka@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:26:24 +0300
Subject: [PATCH] fix(agents): show a delivered run's questions in its reply
 conversation

A gateway agent run with deliver set now publishes its ask_user and
secrets prompts to the conversation that receives its replies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LNTt5yXBj4uDUwJmPGvXLd
---
 src/agents/command/attempt-execution.ts | 19 ++++++++
 src/commands/agent.test.ts              | 59 +++++++++++++++++++++++++
 2 files changed, 78 insertions(+)

diff --git a/src/agents/command/attempt-execution.ts b/src/agents/command/attempt-execution.ts
index ddc3b308368..58799f6b18d 100644
--- a/src/agents/command/attempt-execution.ts
+++ b/src/agents/command/attempt-execution.ts
@@ -1,5 +1,6 @@
 import type { FastMode } from "@openclaw/normalization-core/string-coerce";
 import { sanitizeForLog } from "../../../packages/terminal-core/src/ansi.js";
+import { readAskUserQuestionId } from "../../auto-reply/reply-payload.js";
 import {
   readChannelSourceTurnId,
   readChannelSourceTurnSameThreadRequired,
@@ -76,6 +77,7 @@ import {
 } from "../subagents/announce/subagent-announce-handoff.js";
 import { isRuntimeToolAllowed, isToolAllowedByPolicies } from "../tool-policy-match.js";
 import { DEFAULT_MAX_LIVE_TOOL_RESULT_CHARS } from "../tool-result-limits.js";
+import { createChannelQuestionPromptDelivery } from "../tools/question-prompt-send.js";
 import { resolveHarnessAuthProfileSelection } from "./attempt-auth-selection.js";
 import { emitAgentAttemptRuntimeStart } from "./attempt-callbacks.js";
 import {
@@ -788,12 +790,29 @@ export function runAgentAttempt(
     );
   }
 
+  // A delivered run's question prompts appear in the conversation that receives its replies.
+  const questionPrompt = params.opts.deliver
+    ? createChannelQuestionPromptDelivery({
+        cfg: params.cfg,
+        channel: params.opts.replyChannel ?? params.opts.channel,
+        to: params.opts.replyTo ?? params.opts.to,
+        accountId: params.opts.replyAccountId ?? params.opts.accountId,
+        threadId: params.opts.threadId,
+      })
+    : undefined;
   const embeddedRunParams: RunEmbeddedAgentInternalParams = {
     ...buildCommonRunParams(),
     sandboxSessionKey: params.sessionKey,
     ...toolContext,
     messageTo: params.opts.replyTo ?? params.opts.to,
     messageThreadId: params.opts.threadId,
+    onToolResult: questionPrompt
+      ? async (payload) => {
+          if (readAskUserQuestionId(payload) !== undefined) {
+            await questionPrompt.send(payload);
+          }
+        }
+      : undefined,
     hasRepliedRef: params.runContext.hasRepliedRef,
     permissionMode: params.sessionEntry?.permissionMode,
     toolOverrides: params.sessionEntry?.toolOverrides,
diff --git a/src/commands/agent.test.ts b/src/commands/agent.test.ts
index 51ecfd9e989..a37bd4ba5f5 100644
--- a/src/commands/agent.test.ts
+++ b/src/commands/agent.test.ts
@@ -52,6 +52,7 @@ import type { OpenClawConfig } from "../config/types.openclaw.js";
 import { getBootEchoContextForSession } from "../gateway/boot-echo-guard.js";
 import { runBootOnce } from "../gateway/boot.js";
 import { emitAgentEvent, onAgentEvent, resetAgentEventsForTest } from "../infra/agent-events.js";
+import type { OutboundDeliveryResult } from "../infra/outbound/deliver-types.js";
 import { withTempHomeCore as withTempHomeBase } from "../plugin-sdk/test-helpers/temp-home.js";
 import { loadEnabledClaudeBundleCommands } from "../plugins/bundle-commands.js";
 import type { PluginProviderRegistration } from "../plugins/registry.test-fixtures.js";
@@ -1641,6 +1642,64 @@ describe("agentCommand", () => {
     });
   });
 
+  it.each([true, false])(
+    "publishes question prompts in the reply conversation when deliver=%s",
+    async (deliver) => {
+      await withTempHome(async (home) => {
+        mockConfig(home, path.join(home, "sessions.json"));
+        const sendText = vi.fn(async (): Promise<OutboundDeliveryResult> => ({
+          channel: "telegram",
+          messageId: "card",
+        }));
+        installThinkingTestProviders([
+          {
+            pluginId: "telegram",
+            source: "test",
+            plugin: createOutboundTestPlugin({
+              id: "telegram",
+              outbound: { deliveryMode: "direct", sendText, sendMedia: sendText },
+            }),
+          },
+        ]);
+        attemptExecutionMocks.useRealRunAgentAttempt = true;
+        const prompt = {
+          text: "Keep the subagent session?",
+          channelData: { askUser: { questionId: "settle-question" } },
+        };
+        let publisher: unknown;
+        vi.mocked(runEmbeddedAgent).mockImplementationOnce(async (params) => {
+          publisher = params.onToolResult;
+          await params.onToolResult?.({ text: "exec: date" });
+          await params.onToolResult?.(prompt);
+          return createDefaultAgentResult();
+        });
+
+        await agentCommandFromIngress(
+          {
+            message: "a subagent finished",
+            sessionKey: "agent:main:main",
+            agentId: "main",
+            to: "50721601",
+            channel: "telegram",
+            deliver,
+            allowModelOverride: false,
+          },
+          runtime,
+        );
+
+        if (deliver) {
+          expect(sendText).toHaveBeenCalledOnce();
+          expect(sendText).toHaveBeenCalledWith(
+            expect.objectContaining({ to: "50721601", text: prompt.text }),
+          );
+        } else {
+          expect(publisher).toBeUndefined();
+          expect(sendText).not.toHaveBeenCalled();
+        }
+      });
+    },
+  );
+
   it("does not load the full model catalog for trusted explicit overrides without an allowlist", async () => {
     await withTempHome(async (home) => {
       const store = path.join(home, "sessions.json");
