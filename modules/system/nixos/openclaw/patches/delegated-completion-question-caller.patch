+import path from "node:path";
+import { afterAll, beforeEach, describe, expect, it, vi } from "vitest";
+import type { ReplyToolAuthorityCaller } from "../../auto-reply/reply/reply-run-registry.contracts.js";
+import {
+  prepareReplyToolAuthority,
+  resolveInboundReplyToolAuthorityOverlay,
+} from "../../auto-reply/reply/reply-tool-authority.js";
+import type { RuntimeMsgContext } from "../../auto-reply/templating.js";
+import { replaceSessionEntry } from "../../config/sessions/session-accessor.js";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import {
+  consumeSubagentCompletionToolHandoff,
+  registerSubagentCompletionToolHandoff,
+} from "../../gateway/subagent-completion-tool-handoff.js";
+import { useSessionStoreTempDirs } from "../../test-utils/session-state-cleanup.js";
+import {
+  createAdmittedRunOperatorAuthority,
+  createOperationalRunInstanceRef,
+  prepareAgentRunAdmission,
+} from "../admitted-run-context.js";
+import { prepareOperatorModelPolicy } from "../operator-model-policy.js";
+import { getGatewayToolCallerIdentity } from "../tools/gateway-caller-context.js";
+import type { AgentQuestionDispatcher } from "./gateway-question-dispatch.js";
+import {
+  claimPendingAgentQuestionAnswerFromCaller,
+  registerPendingAgentQuestion,
+} from "./gateway-question.js";
+import { withPreparedEmbeddedRunToolAuthority } from "./tool-authority.runtime.js";
+
+const requesterSessionKey = "agent:main:main";
+const requesterSessionId = "requester-session";
+const childSessionKey = "agent:main:subagent:child";
+const route = { provider: "openai", model: "gpt-test" };
+
+describe("delegated completion question authority", () => {
+  const sessionDirs = useSessionStoreTempDirs(afterAll, "openclaw-delegated-question-");
+  let tempDir: string;
+  let storePath: string;
+
+  beforeEach(async () => {
+    tempDir = sessionDirs.make();
+    storePath = path.join(tempDir, "sessions.json");
+    const child: SessionEntry = {
+      sessionId: "child-session",
+      updatedAt: Date.now(),
+      spawnedBy: requesterSessionKey,
+      spawnDepth: 1,
+      inheritedToolPolicyVersion: 1,
+      inheritedToolAllow: ["read", "exec"],
+      inheritedToolDeny: ["write"],
+    };
+    await replaceSessionEntry({ storePath, sessionKey: childSessionKey }, child);
+  });
+
+  function config(): OpenClawConfig {
+    return { session: { store: storePath } };
+  }
+
+  function telegramMessage(senderId: string): RuntimeMsgContext {
+    return {
+      OriginatingChannel: "telegram",
+      Provider: "telegram",
+      Surface: "telegram",
+      ChatType: "direct",
+      AccountId: "default",
+      SenderId: senderId,
+      SenderName: senderId,
+    };
+  }
+
+  function telegramReply(senderId: string, senderIsOwner: boolean) {
+    return resolveInboundReplyToolAuthorityOverlay({
+      ctx: telegramMessage(senderId),
+      senderIsOwner,
+      disableTools: false,
+    });
+  }
+
+  /** The caller facts a Telegram owner turn records when it spawns a child. */
+  function telegramRequesterCaller(): ReplyToolAuthorityCaller {
+    const caller = prepareReplyToolAuthority({
+      originatingChannel: "telegram",
+      disableTools: false,
+      run: {
+        config: config(),
+        sessionKey: requesterSessionKey,
+        sessionId: requesterSessionId,
+        sessionFile: path.join(tempDir, "requester.jsonl"),
+        workspaceDir: tempDir,
+        provider: route.provider,
+        model: route.model,
+        messageProvider: "telegram",
+        chatType: "direct",
+        agentAccountId: "default",
+        senderId: "owner",
+        senderName: "owner",
+        senderIsOwner: true,
+        traceAuthorized: true,
+      },
+    }).caller;
+    expect(caller).toBeDefined();
+    return caller!;
+  }
+
+  function consumeSettleHandoff(requesterCaller?: ReplyToolAuthorityCaller) {
+    const registration = {
+      sourceSessionKey: childSessionKey,
+      targetSessionKey: requesterSessionKey,
+      targetSessionId: requesterSessionId,
+      idempotencyKey: "announce:requester-settle:test",
+      settleBatch: { sourceSessionKeys: [childSessionKey], isCurrent: () => true },
+      ...(requesterCaller ? { requesterCaller } : {}),
+    };
+    const handoff = consumeSubagentCompletionToolHandoff({
+      ...registration,
+      handoffId: registerSubagentCompletionToolHandoff(registration),
+      sourceTool: "subagent_settle",
+      ...route,
+    });
+    expect(handoff).toBeDefined();
+    return handoff!;
+  }
+
+  async function withSettleRunQuestion(
+    trustedInternalHandoff: ReturnType<typeof consumeSettleHandoff>,
+    run: (answer: (caller: ReturnType<typeof telegramReply>) => Promise<boolean>) => Promise<void>,
+  ) {
+    const runId = "announce:requester-settle:test";
+    const admission = prepareAgentRunAdmission({
+      cfg: {},
+      operationalRunInstance: createOperationalRunInstanceRef(runId),
+      facts: {
+        agentId: "main",
+        runId,
+        ingress: { kind: "system", state: "present", boundary: "delegated-question-test" },
+      },
+    });
+    try {
+      const admittedRunContext = await admission.admit("embedded", "delegated-question-test");
+      await withPreparedEmbeddedRunToolAuthority(
+        { admittedRunContext },
+        {
+          sessionId: requesterSessionId,
+          sessionKey: requesterSessionKey,
+          runId,
+          agentId: "main",
+          config: config(),
+          sessionFile: path.join(tempDir, "requester.jsonl"),
+          workspaceDir: tempDir,
+          provider: route.provider,
+          modelId: route.model,
+          sandboxSessionKey: requesterSessionKey,
+          messageChannel: "telegram",
+          messageProvider: "telegram",
+          senderIsOwner: true,
+          inputProvenance: {
+            kind: "inter_session",
+            sourceTool: "subagent_settle",
+            sourceSessionKey: childSessionKey,
+          },
+          trustedInternalHandoff,
+        },
+        undefined,
+        async () => {
+          const question = registerPendingAgentQuestion({
+            questionId: "settle-question",
+            sessionKey: requesterSessionKey,
+            questions: [{ id: "choice", header: "Choice", question: "Apply the fix?" }],
+            gatewayCall: { version: 2, call: dispatch },
+            answer: Promise.resolve({ status: "pending" }),
+          });
+          question.attachRegistration(Promise.resolve({ id: "settle-question" }));
+          try {
+            await run((caller) =>
+              claimPendingAgentQuestionAnswerFromCaller({
+                sessionKey: requesterSessionKey,
+                text: "Approve",
+                caller,
+                assertSourceCurrent: () => {},
+              }),
+            );
+          } finally {
+            question.dispose();
+          }
+        },
+      );
+    } finally {
+      admission.close();
+    }
+  }
+
+  const dispatch = vi.fn<AgentQuestionDispatcher["call"]>(async ({ authority }) => {
+    if (authority.kind === "source-bound") {
+      authority.assertCurrent();
+    }
+    return { status: "answered" };
+  });
+
+  beforeEach(() => {
+    dispatch.mockClear();
+  });
+
+  it("accepts a settle-run answer from the delegating caller and refuses other senders", async () => {
+    await withSettleRunQuestion(consumeSettleHandoff(telegramRequesterCaller()), async (answer) => {
+      await expect(answer(telegramReply("mallory", false))).rejects.toThrow("caller policy");
+      expect(dispatch).not.toHaveBeenCalled();
+      await expect(answer(telegramReply("owner", true))).resolves.toBe(true);
+      expect(dispatch).toHaveBeenCalledOnce();
+    });
+  });
+
+  it("refuses channel answers when the settle run records no delegating caller", async () => {
+    await withSettleRunQuestion(consumeSettleHandoff(), async (answer) => {
+      await expect(answer(telegramReply("owner", true))).rejects.toThrow("caller policy");
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  });
+
+  it("refuses the delegating caller once the settle batch is revoked", async () => {
+    let current = true;
+    const handoff = consumeSettleHandoff(telegramRequesterCaller());
+    const revocable = {
+      ...handoff,
+      settleBatch: { ...handoff.settleBatch!, isCurrent: () => current },
+    };
+    current = false;
+    await withSettleRunQuestion(revocable, async (answer) => {
+      await expect(answer(telegramReply("owner", true))).rejects.toThrow("caller policy");
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  });
+
+  it("hands the delegating caller to work the settle run delegates", async () => {
+    const requesterCaller = telegramRequesterCaller();
+    await withSettleRunQuestion(consumeSettleHandoff(requesterCaller), async () => {
+      expect(getGatewayToolCallerIdentity()?.requesterCaller).toBe(requesterCaller);
+    });
+  });
+
+  it("records no durable caller for an operator-admitted turn", () => {
+    const operatorAuthority = createAdmittedRunOperatorAuthority({
+      profileId: "operator",
+      scopes: ["operator.read", "operator.write"],
+      gatewayAccessGrant: null,
+      modelPolicy: prepareOperatorModelPolicy({ cfg: {}, policy: {} }),
+      assertCurrent() {},
+    });
+    const snapshot = prepareReplyToolAuthority({
+      operatorAuthority,
+      run: {
+        config: config(),
+        sessionKey: requesterSessionKey,
+        sessionId: requesterSessionId,
+        sessionFile: path.join(tempDir, "requester.jsonl"),
+        workspaceDir: tempDir,
+        provider: route.provider,
+        model: route.model,
+        messageProvider: "webchat",
+        senderIsOwner: true,
+      },
+    });
+    expect(snapshot.caller).toBeUndefined();
+  });
+});
