+
+function readVerifiedDelegatedCaller(
+  input: ReplyToolAuthorityInput,
+  route: ReplyToolAuthorityRoute,
+): ReplyToolAuthorityCaller | undefined {
+  const handoff = input.run.trustedInternalHandoff;
+  return handoff?.requesterCaller &&
+    hasVerifiedRequesterCompletionHandoff({
+      config: input.run.config,
+      sessionKey: input.run.sessionKey,
+      sessionId: input.run.sessionId,
+      inputProvenance: input.run.inputProvenance,
+      trustedInternalHandoff: handoff,
+      modelProvider: route.provider,
+      modelId: route.model,
+    })
+    ? handoff.requesterCaller
+    : undefined;
+}
