+
+function readReplyToolAuthorityCaller(
+  snapshot: ReplyToolAuthorityInput,
+): ReplyToolAuthorityCaller | undefined {
+  const { run } = snapshot;
+  // Operator and internal grants are live authority that a durable caller cannot hold.
+  if (
+    snapshot.operatorAuthority ||
+    run.trustedInternalHandoff ||
+    run.scheduledToolPolicy ||
+    run.runtimePluginToolGrant
+  ) {
+    return undefined;
+  }
+  return Object.freeze(
+    structuredClone({
