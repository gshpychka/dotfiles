+import { describe, expect, it } from "vitest";
+import type { SubagentRunRecord } from "../registry/subagent-registry.types.js";
+import { resolveSettledBatchSource } from "./subagent-announce.requester-settle-state.js";
+
+const owner = {
+  messageProvider: "telegram",
+  senderId: "owner",
+  senderIsOwner: true,
+  disableTools: false,
+  traceAuthorized: true,
+};
+
+function run(requesterCaller?: typeof owner): Pick<SubagentRunRecord, "requesterCaller"> {
+  return { requesterCaller };
+}
+
+describe("resolveSettledBatchSource", () => {
+  const keys = ["agent:main:subagent:a", "agent:main:subagent:b"];
+
+  it("reports the batch as one settle continuation", () => {
+    expect(resolveSettledBatchSource([run(owner)], keys)).toEqual({
+      sourceSessionKey: keys[0],
+      settleWakeSourceSessionKeys: keys,
+      sourceTool: "subagent_settle",
+      requesterCaller: owner,
+    });
+  });
+
+  it("keeps the caller every run recorded", () => {
+    expect(
+      resolveSettledBatchSource([run(owner), run({ ...owner })], keys).requesterCaller,
+    ).toEqual(owner);
+  });
+
+  it.each([
+    ["a different sender", run({ ...owner, senderId: "mallory" })],
+    ["no recorded caller", run()],
+  ])("leaves the caller unset when a run has %s", (_label, other) => {
+    expect(resolveSettledBatchSource([run(owner), other], keys)).not.toHaveProperty(
+      "requesterCaller",
+    );
+    expect(resolveSettledBatchSource([other, run(owner)], keys)).not.toHaveProperty(
+      "requesterCaller",
+    );
+  });
+});
