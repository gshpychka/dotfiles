+export function resolveDurableReplyToolAuthorityOverlay(
+  caller: ReplyToolAuthorityCaller,
+  session: Pick<ReplyToolAuthorityInput["run"], "permissionMode" | "toolOverrides" | "spawnedBy">,
+): ReplyToolAuthorityOverlay {
