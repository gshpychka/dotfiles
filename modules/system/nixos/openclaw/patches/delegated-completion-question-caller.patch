+/** The overlay a durable caller's next inbound turn carries in the given session. */
+export function resolveDurableReplyToolAuthorityOverlay(
+  caller: ReplyToolAuthorityCaller,
+  session: Pick<ReplyToolAuthorityInput["run"], "permissionMode" | "toolOverrides" | "spawnedBy">,
+): ReplyToolAuthorityOverlay {
+  return {
+    ...caller,
+    permissionMode: session.permissionMode,
+    toolOverrides: session.toolOverrides,
+    spawnedBy: normalizeOptionalString(session.spawnedBy),
+  };
+}
+
+function readReplyToolAuthorityCaller(
+  snapshot: ReplyToolAuthorityInput,
+): ReplyToolAuthorityCaller | undefined {
+  const { run } = snapshot;
+  // Operator and internal grants are live authority that a durable caller cannot hold.
+  if (
+    snapshot.operatorAuthority ||
+    run.trustedInternalHandoff ||
+    run.scheduledToolPolicy ||
+    run.runtimePluginToolGrant
+  ) {
+    return undefined;
+  }
+  return Object.freeze(
+    structuredClone({
+      originatingChannel: snapshot.originatingChannel,
+      toolsAllow: snapshot.toolsAllow,
+      disableTools: snapshot.disableTools === true,
+      messageProvider: run.messageProvider,
+      chatType: run.chatType,
+      agentAccountId: run.agentAccountId,
+      conversationToolPolicy: run.conversationToolPolicy,
+      groupId: run.groupId,
+      groupChannel: run.groupChannel,
+      groupSpace: run.groupSpace,
+      memberRoleIds: run.memberRoleIds,
+      senderId: run.senderId,
+      senderName: run.senderName,
+      senderUsername: run.senderUsername,
