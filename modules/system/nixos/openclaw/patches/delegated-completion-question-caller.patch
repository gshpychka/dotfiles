+/** Settled batch provenance, with the requester caller recorded by every run in the batch. */
+export function resolveSettledBatchSource(
+  batch: readonly Pick<SubagentRunRecord, "requesterCaller">[],
+  sourceSessionKeys: readonly string[],
+) {
+  const [requesterCaller, ...rest] = batch.map((entry) => entry.requesterCaller);
+  const key = requesterCaller && stableStringify(requesterCaller);
+  return {
+    sourceSessionKey: sourceSessionKeys[0],
+    settleWakeSourceSessionKeys: sourceSessionKeys,
+    sourceTool: "subagent_settle",
+    ...(requesterCaller && rest.every((caller) => caller && stableStringify(caller) === key)
+      ? { requesterCaller }
+      : {}),
+  };
+}
