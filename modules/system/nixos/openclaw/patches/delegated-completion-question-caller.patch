+
+function readDelegatedCaller(
+  attempt: Pick<
+    ToolAuthorityAttempt,
+    "completionHandoff" | "inputProvenance" | "sessionKey" | "sessionId"
+  >,
+  route: ReplyToolAuthorityRoute,
+): ReplyToolAuthorityCaller | undefined {
+  const handoff = attempt.completionHandoff;
+  return handoff?.requesterCaller &&
+    isTrustedSubagentCompletionHandoffForRun({
+      handoff,
+      inputProvenance: attempt.inputProvenance,
+      sessionKey: attempt.sessionKey,
+      sessionId: attempt.sessionId,
+      provider: route.provider,
+      model: route.model,
+    })
+    ? handoff.requesterCaller
+    : undefined;
+}
