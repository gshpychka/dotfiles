diff --git a/src/gateway/agent-runtime-approval-requester.ts b/src/gateway/agent-runtime-approval-requester.ts
new file mode 100644
--- /dev/null
+++ b/src/gateway/agent-runtime-approval-requester.ts
@@ -0,0 +1,20 @@
+import type { GatewayRequestContext, GatewayRequestOptions } from "./server-methods/types.js";
+
+/** Built-in approval producers can register and observe their own run, never review approvals. */
+export function holdsAgentRuntimeApprovalRequesterAuthority(
+  method: string,
+  client: GatewayRequestOptions["client"],
+  context: Pick<GatewayRequestContext, "validateAgentRuntimeApprovalAuthority">,
+): boolean {
+  if (method !== "exec.approval.request" && method !== "exec.approval.waitDecision") {
+    return false;
+  }
+  const identity = client?.internal?.agentRuntimeIdentity;
+  return Boolean(
+    client?.internal?.syntheticClient === true &&
+    !client.invalidated &&
+    identity &&
+    client.connId === `agent-runtime:${identity.operationalRunInstance.instanceId}` &&
+    context.validateAgentRuntimeApprovalAuthority?.(identity) === true,
+  );
+}
diff --git a/src/gateway/agent-runtime-approval-requester.test.ts b/src/gateway/agent-runtime-approval-requester.test.ts
