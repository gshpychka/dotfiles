@@ -0,0 +1,182 @@
+import { expectDefined } from "@openclaw/normalization-core/expect";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createOperationalRunInstanceRef } from "../agents/admitted-run-context.js";
+import { withGatewayToolCallerIdentity } from "../agents/tools/gateway-caller-context.js";
+import { callGatewayTool } from "../agents/tools/gateway.js";
+import { clearRuntimeConfigSnapshot, setRuntimeConfigSnapshot } from "../config/config.js";
+import {
+  claimAgentRunDelegatedAuthority,
+  releaseAgentRunDelegatedAuthority,
+  validateAgentRunDelegatedAuthority,
+} from "../infra/agent-run-registry.js";
+import { withPluginRuntimeGatewayRequestScope } from "../plugins/runtime/gateway-request-scope.js";
+import { createAgentRuntimeApprovalAuthorityValidator } from "./agent-runtime-approval-authority.js";
+import { createPreparedTestApprovalManager } from "./exec-approval-manager.test-support.js";
+import { createGatewayMethodRegistry } from "./methods/registry.js";
+import { createExecApprovalHandlers } from "./server-methods/exec-approval.js";
+import type {
+  GatewayRequestContext,
+  GatewayRequestHandlerOptions,
+} from "./server-methods/types.js";
+import { createContext } from "./server-plugin-in-process-dispatch.test-support.js";
+import { createSyntheticPluginRuntimeClient } from "./server-plugin-runtime-client.js";
+
+let context: GatewayRequestContext;
+let currentContext: GatewayRequestContext | undefined;
+type Caller = NonNullable<Parameters<typeof withGatewayToolCallerIdentity>[0]>;
+async function withCaller<T>(overrides: Partial<Caller>, run: () => Promise<T>) {
+  const caller = {
+    agentId: "ops",
+    sessionKey: "agent:ops:main",
+    ...overrides,
+    operationalRunInstance:
+      overrides.operationalRunInstance ?? createOperationalRunInstanceRef("requester-regression"),
+  };
+  const authority = claimAgentRunDelegatedAuthority(caller.operationalRunInstance);
+  try {
+    return await withGatewayToolCallerIdentity(
+      { ...caller, receiptAuthority: () => validateAgentRunDelegatedAuthority(authority) },
+      run,
+    );
+  } finally {
+    releaseAgentRunDelegatedAuthority(authority);
+  }
+}
+
+// No mocked server-methods or scope admission: tools, router, handlers and store are real.
+describe("scoped System approval requester through Gateway router", () => {
+  beforeEach(() => {
+    setRuntimeConfigSnapshot({ gateway: { mode: "local", port: 18789 } });
+    context = createContext();
+    context.validateAgentRuntimeApprovalAuthority = createAgentRuntimeApprovalAuthorityValidator();
+    currentContext = context;
+  });
+  afterEach(() => clearRuntimeConfigSnapshot());
+  it.for(["agent:ops:main", "agent:ops:subagent:approval-child"])(
+    "registers and waits only for its own approval from scoped System %s",
+    async (sessionKey, test) => {
+      const { manager, run, track } = await createPreparedTestApprovalManager(test, {
+        validateAgentRuntimeDelegatedAuthority: validateAgentRunDelegatedAuthority,
+      });
+      const handlers = createExecApprovalHandlers(manager);
+      const observed: GatewayRequestHandlerOptions[] = [];
+      const methodRegistry = createGatewayMethodRegistry(
+        Object.entries(handlers).map(([name, handler]) => ({
+          name,
+          handler: async (options: GatewayRequestHandlerOptions) => {
+            observed.push(options);
+            await handler(options);
+          },
+          owner: { kind: "core" as const, area: "approval-requester-regression" },
+          scope: "operator.approvals" as const,
+        })),
+      );
+      context = {
+        ...context,
+        getGatewayMethodRegistry: () => methodRegistry,
+        chatRunState: { hasAbortMarker: () => false },
+        broadcast: vi.fn(),
+        hasExecApprovalClients: () => true,
+      } as GatewayRequestContext;
+      currentContext = context;
+      const source = createSyntheticPluginRuntimeClient({
+        operatorRoleActor: { kind: "system" },
+        scopes: ["operator.write"],
+      });
+      await run(() =>
+        withPluginRuntimeGatewayRequestScope(
+          { client: source, context, isWebchatConnect: () => false },
+          () =>
+            withCaller({ sessionKey, gatewayContextResolver: () => currentContext }, async () => {
+              const registration = await callGatewayTool<{ id: string }>(
+                "exec.approval.request",
+                {},
+                {
+                  id: "scoped-system-approval",
+                  host: "gateway",
+                  command: "echo synthetic",
+                  twoPhase: true,
+                },
+                { expectFinal: false },
+              );
+              const request = observed.at(-1);
+              expect(request?.client?.connect.scopes).not.toContain("operator.approvals");
+              expect(request?.client?.internal?.approvalRuntime).not.toBe(true);
+              expect(source.connect.scopes).toEqual(["operator.write"]);
+              const own = expectDefined(
+                await manager.getSnapshot(registration.id),
+                "registered approval",
+              );
+              expect(own.requestedByConnId).toBe(request?.client?.connId);
+              for (const method of [
+                "exec.approval.resolve",
+                "exec.approval.get",
+                "exec.approval.list",
+                "config.patch",
+              ]) {
+                await expect(
+                  callGatewayTool(method, {}, { id: registration.id, decision: "allow-once" }),
+                ).rejects.toThrow(/missing scope/);
+              }
+              await withCaller(
+                {
+                  sessionKey,
+                  operationalRunInstance: createOperationalRunInstanceRef("foreign-requester"),
+                  gatewayContextResolver: () => currentContext,
+                },
+                async () => {
+                  await expect(
+                    callGatewayTool("exec.approval.waitDecision", {}, { id: registration.id }),
+                  ).rejects.toThrow(/expired or not found/);
+                },
+              );
+              const unbound = manager.create(
+                { command: "echo other producer" },
+                60_000,
+                "unbound-approval",
+              );
+              const unboundDecision = track((await manager.register(unbound, 60_000)).decision);
+              await manager.resolve(unbound.id, "allow-once");
+              await unboundDecision;
+              await expect(
+                callGatewayTool("exec.approval.waitDecision", {}, { id: unbound.id }),
+              ).rejects.toThrow(/expired or not found/);
+              const waiting = track(
+                callGatewayTool<{ decision: string }>(
+                  "exec.approval.waitDecision",
+                  {},
+                  { id: registration.id },
+                ),
+              );
+              await manager.resolve(registration.id, "allow-once");
+              await expect(waiting).resolves.toMatchObject({
+                id: registration.id,
+                decision: "allow-once",
+              });
+              const controller = new AbortController();
+              const cancelled = await callGatewayTool<{ id: string }>(
+                "exec.approval.request",
+                {},
+                {
+                  id: "cancelled-system-approval",
+                  host: "gateway",
+                  command: "echo cancelled",
+                  twoPhase: true,
+                },
+                { expectFinal: false, signal: controller.signal },
+              );
+              controller.abort(new Error("requesting tool cancelled"));
+              expect(await manager.resolve(cancelled.id, "allow-once")).toBe(false);
+              expect(manager.projectDecisionIfActive(cancelled.id, "allow-once")).toBeNull();
+              const admittedContext = currentContext;
+              currentContext = { ...context };
+              await expect(
+                callGatewayTool("exec.approval.waitDecision", {}, { id: registration.id }),
+              ).rejects.toThrow(/Gateway instance unavailable/);
+              currentContext = admittedContext;
+            }),
+        ),
+      );
+    },
+  );
+});
